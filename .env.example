# ==============================================================================
# UXMB Task Request Portal - Environment Configuration Template
# Copy this file to .env or .env.local for local overrides
# ==============================================================================

# Application Environment: 'production' | 'preview' | 'development'
VITE_APP_ENV=production

# Google Apps Script Web App Endpoint URL
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyz4_GK_guUx9L6uaRd4vK5jqJwG60eLr8Xju3j2hcEUianS8873cp4fJe8BBBrilKQ/exec

# Google Master Spreadsheet ID
VITE_GOOGLE_SHEET_ID=1gpe5W7whAMxIZLjsjVxEW23vcaa9ny0m9Qj327zKYzw

# Leave Management Google Sheet URL & GID
VITE_LEAVE_SHEET_URL=https://docs.google.com/spreadsheets/d/1oeDjaIMIuDsG2bDG2HT8euLICVXxQvWpf-2jfDr3Vlg/edit?gid=917777763
VITE_LEAVE_SHEET_GID=917777763

# OTP Authentication: Allow local dev bypass (strictly false for production)
VITE_ENABLE_DEV_OTP_BYPASS=false

# AI Gateway — server-side only. Never expose provider keys through VITE_* variables.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Apps Script endpoint used by the server gateway to verify sessions.
GAS_EXEC_URL=https://script.google.com/macros/s/your_deployment_id/exec

# Distributed production rate limit. Production intentionally returns 503 when
# these variables are missing or the store is unavailable.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Local development only. Keep unset/false in preview and production.
ALLOW_UNAUTHENTICATED_AI_DEV=false
