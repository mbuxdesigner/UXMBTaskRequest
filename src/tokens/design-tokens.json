  "typography": {
    "fontFamily": {
      "sans": {
        "value": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "type": "fontFamily",
        "description": "Font chữ mặc định cho toàn bộ giao diện"
      },
      "mono": {
        "value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
        "type": "fontFamily",
        "description": "Font chữ hiển thị mã Request ID, code, dữ liệu kỹ thuật"
      }
    },
    "header": {
