        "fontFamily": "{typography.fontFamily.sans.value}",
        "fontSize": "1.75rem",
        "fontSizePx": "28px",
        "lineHeight": "2.25rem",
        "fontWeight": 700,
        "letterSpacing": "-0.025em",
        "description": "Tiêu đề trang chính (VD: 'Tổng quan hệ thống', 'Tạo yêu cầu', 'Tra cứu yêu cầu')"
      },
      "h2": {
        "fontFamily": "{typography.fontFamily.sans.value}",
        "fontSize": "1.375rem",
        "fontSizePx": "22px",
        "lineHeight": "1.75rem",
        "fontWeight": 700,
        "letterSpacing": "-0.02em",
        "description": "Tiêu đề khối lớn / Section Header (VD: 'Tình trạng UX Squad', 'Chi tiết yêu cầu')"
      },
      "h3": {
        "fontFamily": "{typography.fontFamily.sans.value}",
